# ---- Servidor ----
PORT=4000
# Banco SQLite (libsql). Local: um arquivo. Produção: caminho persistente.
DB_URL=file:./data/mesao.db
# Onde ficam os avatares dos jogadores.
UPLOADS_DIR=./uploads
NODE_ENV=development

# ---- Acesso (login simples por senha compartilhada) ----
# Senha que os amigos usam pra entrar na sala do mesão.
# OBRIGATÓRIO em produção. Se ficar vazio, o app roda ABERTO (só use em dev).
ACCESS_PASSWORD=
# Segredo pra assinar o token de sessão. Troque por algo aleatório em produção.
SESSION_SECRET=troque-por-um-segredo-aleatorio
# Validade do token de sessão (formato do jose: 30d, 12h, etc.).
SESSION_TTL=30d
