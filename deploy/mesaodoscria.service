[Unit]
Description=Mesao dos Cria (contador de vida + ranking de Commander)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/MesaoDosCria/server
ExecStart=/usr/bin/node dist/index.js
Environment=NODE_ENV=production
Environment=PORT=4100
# Senha da sala (ACCESS_PASSWORD) e SESSION_SECRET ficam aqui, fora do git.
# O "-" faz o serviço subir normalmente mesmo se o arquivo ainda não existir.
EnvironmentFile=-%h/MesaoDosCria/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
